# OpenAI (chat streaming for text + Realtime API for voice)
OPENAI_API_KEY=

# Models
LLM_MODEL=gpt-4o-mini
# Bump independently of LLM_MODEL if the planner misroutes (see config.py comment).
PLANNER_MODEL=gpt-4o-mini
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin

# Streaming STT (Realtime transcription). Leave blank to use OpenAI defaults.
REALTIME_TRANSCRIBE_MODEL=gpt-4o-transcribe
REALTIME_TRANSCRIBE_LANGUAGE=en

# Bug 4 (trailing phantom-token) mitigation knobs.
# noise_reduction=far_field is the ADOPTED fix (Phase 2, 2026-07-13): cuts the
# trailing phantom token ~2/3 with no accuracy/latency cost. Use near_field for
# a close headset mic, or leave blank to disable. The rest stay blank (their
# Phase 2 sweeps found no further win -- see bug-report-streaming-stt.md).
# "" | near_field | far_field
REALTIME_NOISE_REDUCTION=far_field
# VAD speech-probability cutoff (API default 0.5); try 0.55 / 0.60 / 0.65
REALTIME_VAD_THRESHOLD=
# audio kept before speech onset, ms (API default 300)
REALTIME_PREFIX_PADDING_MS=
# silence to close a segment, ms (API default 500)
REALTIME_SILENCE_DURATION_MS=
# free-text decoding bias (weak lever)
REALTIME_TRANSCRIBE_PROMPT=

# Diagnostic: write received PCM to tmp/stt_capture_<session>.wav (Phase 1)
STT_DEBUG_CAPTURE=false

# Ingestion pipeline, Stage 1 (parsing): LlamaParse (cloud) -- required to
# run scripts/parse_documents.py. Get a key at https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=
INGESTION_INPUT_DIR=data/input
INGESTION_OUTPUT_DIR=data/output

# Ingestion pipeline, Stage 2 (chunking) -- no API key needed, pure local processing.
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# Ingestion pipeline, Stage 3 (embed + upsert): Pinecone (cloud) -- required to
# run scripts/ingest_documents.py. Get a key at https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX_NAME=avatar-poc-content
PINECONE_NAMESPACE=avatar-poc
EMBEDDING_MODEL=llama-text-embed-v2

# Retrieval (Stage 4, query time) -- dense search only for now, no reranking.
RETRIEVAL_TOP_K=3
# Deterministic grounding gate: below this top-chunk score, stream_rag_response()
# abstains without calling the LLM. Calibrated on real queries against this
# corpus -- see the comment in app/core/config.py.
RETRIEVAL_SCORE_FLOOR=0.35

# Answer source toggle for /ws/voice: "gpt" (plain LLM, no retrieval, current
# default), "rag" (single-turn: retrieves top chunks from Pinecone and grounds
# the answer in them -- see app/services/rag_stream.py), or "agent" (Step 5:
# planner routes conversational-vs-lookup + per-thread memory across turns,
# built on the same retrieval/grounding -- see app/services/agent.py).
ANSWER_SOURCE=gpt

# Observability (Step 8) -- both fully optional; the app behaves identically
# without either configured, just without traces reaching a dashboard. See
# app/core/observability.py for wiring.
# Logfire: get a token at https://logfire.pydantic.dev
LOGFIRE_TOKEN=
# LangSmith: get a key at https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=avatar-poc
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# HeyGen LiveAvatar (streaming lip-synced avatar) -- get a key at
# https://app.liveavatar.com. LITE mode: our own TTS audio drives the avatar's
# lip-sync, HeyGen never synthesizes speech, so there's no voice id to set.
HEYGEN_API_KEY=
HEYGEN_API_BASE=https://api.liveavatar.com/v1
# Sandbox is free (zero credits) but locked to this avatar, ~1 min/session.
# Get a real avatar_id (UUID) from the dashboard and set this to false to go live.
HEYGEN_AVATAR_ID=dd73ea75-1218-4ef3-92ce-606d5f7fbc0a
HEYGEN_IS_SANDBOX=true
HEYGEN_VIDEO_QUALITY=high
HEYGEN_VIDEO_ENCODING=H264
HEYGEN_SESSION_TIMEOUT_S=30.0

# App
APP_ENV=local
LOG_LEVEL=INFO
