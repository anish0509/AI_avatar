OPENAI_API_KEY=

LLM_MODEL=gpt-4o-mini
PLANNER_MODEL=gpt-4o-mini
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin

REALTIME_TRANSCRIBE_MODEL=gpt-4o-transcribe
REALTIME_TRANSCRIBE_LANGUAGE=en

REALTIME_NOISE_REDUCTION=far_field
REALTIME_VAD_THRESHOLD=
REALTIME_PREFIX_PADDING_MS=
REALTIME_SILENCE_DURATION_MS=
REALTIME_TRANSCRIBE_PROMPT=

STT_DEBUG_CAPTURE=false

LLAMA_CLOUD_API_KEY=
INGESTION_INPUT_DIR=data/input
INGESTION_OUTPUT_DIR=data/output

CHUNK_SIZE=1500
CHUNK_OVERLAP=200

PINECONE_API_KEY=
PINECONE_INDEX_NAME=avatar-poc-content
PINECONE_NAMESPACE=avatar-poc
EMBEDDING_MODEL=llama-text-embed-v2

RETRIEVAL_TOP_K=3
RETRIEVAL_SCORE_FLOOR=0.35

ANSWER_SOURCE=gpt

LOGFIRE_TOKEN=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=avatar-poc
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

HEYGEN_API_KEY=
HEYGEN_API_BASE=https://api.liveavatar.com/v1
HEYGEN_AVATAR_ID=dd73ea75-1218-4ef3-92ce-606d5f7fbc0a
HEYGEN_IS_SANDBOX=true
HEYGEN_VIDEO_QUALITY=high
HEYGEN_VIDEO_ENCODING=H264
HEYGEN_SESSION_TIMEOUT_S=30.0

APP_ENV=local
LOG_LEVEL=INFO

# Use Redis for persistent history or multiple API workers.
MEMORY_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
MEMORY_TTL_SECONDS=86400
